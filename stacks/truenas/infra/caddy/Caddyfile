{
  acme_dns cloudflare {env.CF_DNS_API_TOKEN}
}

*.beansrn.com {
  @nas host nas.beansrn.com
  handle @nas {
    reverse_proxy host.docker.internal:81
  }

  @jellyfin host jf.beansrn.com
  handle @jellyfin {
    reverse_proxy jellyfin:8096
  }

  @glances host glances-nas.beansrn.com
  handle @glances {
    reverse_proxy glances:61208
  }

  @syncthing host st-nas.beansrn.com
  handle @syncthing {
    reverse_proxy syncthing:8384 {
      header_up X-Forwarded-Proto https
      header_up X-Real-IP {remote_host}
    }
  }
}
